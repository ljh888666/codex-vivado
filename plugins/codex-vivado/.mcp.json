{
  "mcpServers": {
    "vivado": {
      "command": "python",
      "args": ["-B", "-X", "utf8", "./scripts/launch_mcp.py"],
      "cwd": ".",
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 1800,
      "env": {"PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8", "PYTHONDONTWRITEBYTECODE": "1"}
    }
  }
}
